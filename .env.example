# ---- Public ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only — never expose with NEXT_PUBLIC_ ----
# Storage of leads / orders (Supabase REST, service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Live market data: DIM.RIA official API (developers.ria.com). Without it, valuations use labelled demo comps.
RIA_API_KEY=

# OpenStreetMap services. Public instances have strict usage policies: identify yourself and keep volume low.
CONTACT_EMAIL=lashchivskyi@gmail.com
# Comma-separated Overpass endpoints tried in order (point to a self-hosted instance in production)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Payments
# monobank acquiring (UAH; card, Apple Pay, Google Pay). Test token: https://api.monobank.ua/
MONOBANK_TOKEN=
# Stripe Checkout (USD, international cards + Apple/Google Pay). Requires a non-Ukrainian legal entity.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional reliable geocoding/POI provider (else public Photon). https://www.geoapify.com
GEOAPIFY_API_KEY=858f5b6d69be438c96d98166e5edbc4f
# Self-hosted Photon (recommended for production)
PHOTON_URL=https://photon.komoot.io
# Public phone shown in the contact dock (default is a test placeholder)
NEXT_PUBLIC_CONTACT_PHONE=

# Private bucket for client documents & photos (create it in Supabase Storage as PRIVATE)
SUPABASE_DOCS_BUCKET=documents

# Google Maps Platform (optional, best private-sector POI coverage). BOTH keys are required: Places data may only be shown on a Google map.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ---- Operations platform (cases, roles, admin) ----
# Postgres / Supabase connection string for production. Empty → embedded PGlite database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Local private file storage when Supabase Storage is not configured (never under public/)
UPLOADS_DIR=.data/uploads
